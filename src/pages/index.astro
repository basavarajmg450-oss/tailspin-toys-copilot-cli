---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';
import { getAllCategories } from '../lib/categories';

export const prerender = true;

const publishers = await getAllPublishers(getDatabase());
const categories = await getAllCategories(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg" data-testid="games-filters">
      <form method="get" class="flex flex-col gap-4 md:flex-row md:items-end">
        <div class="flex-1">
          <label for="publisherId" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisherId"
            name="publisherId"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <label for="categoryId" class="mb-2 block text-sm font-medium text-slate-200">Category</label>
          <select
            id="categoryId"
            name="categoryId"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="category-filter"
          >
            <option value="">All categories</option>
            {categories.map((category) => (
              <option value={String(category.id)}>
                {category.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex gap-3 md:pt-6">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
            hidden
          >
            Clear
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <EmptyState text="No games match the selected filters." />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const parseFilterValue = (value) => {
    if (!value || !/^\d+$/.test(value)) {
      return '';
    }

    const parsed = Number.parseInt(value, 10);
    return Number.isFinite(parsed) && parsed > 0 ? String(parsed) : '';
  };

  const params = new URLSearchParams(window.location.search);
  const publisherId = parseFilterValue(params.get('publisherId'));
  const categoryId = parseFilterValue(params.get('categoryId'));
  const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');
  const categoryFilter = document.querySelector('[data-testid="category-filter"]');
  const clearFilters = document.querySelector('[data-testid="clear-filters"]');
  const gamesGrid = document.querySelector('[data-testid="games-grid"]');
  const emptyState = document.querySelector('[data-testid="empty-state"]');
  const gameCards = document.querySelectorAll('[data-testid="game-card"]');

  if (publisherFilter instanceof HTMLSelectElement) {
    publisherFilter.value = publisherId;
  }

  if (categoryFilter instanceof HTMLSelectElement) {
    categoryFilter.value = categoryId;
  }

  let visibleGameCount = 0;
  gameCards.forEach((card) => {
    const matchesPublisher = !publisherId || card.dataset.publisherId === publisherId;
    const matchesCategory = !categoryId || card.dataset.categoryId === categoryId;
    const isVisible = matchesPublisher && matchesCategory;

    card.toggleAttribute('hidden', !isVisible);
    if (isVisible) {
      visibleGameCount += 1;
    }
  });

  if (gamesGrid instanceof HTMLElement) {
    gamesGrid.toggleAttribute('hidden', visibleGameCount === 0);
  }

  if (emptyState instanceof HTMLElement) {
    emptyState.toggleAttribute('hidden', visibleGameCount !== 0);
  }

  if (clearFilters instanceof HTMLElement) {
    clearFilters.toggleAttribute('hidden', !publisherId && !categoryId);
  }
</script>
